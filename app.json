{
  "expo": {
    "name": "DailyCare",
    "slug": "dailycare-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dailycare",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ai.inktree.dailycare",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#FBF7F0"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ai.inktree.dailycare",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "DailyCare needs your photo library so you can attach a picture from the day to a resident’s update.",
          "cameraPermission": "DailyCare needs the camera so you can take a picture of the day to send with a resident’s update."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#FBF7F0",
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#FBF7F0",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7a13714f-f2d7-4dfd-b742-4673f5ec74d6"
      }
    },
    "owner": "jenithsolution"
  }
}